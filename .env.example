AGENTVERSE_KEY=
ASI1_API_KEY=
AGENT_SEED_PHRASE=
# Payment ledger only. Agent identity always stays on mainnet.
FET_NETWORK=testnet
AGENT_PORT=8001
# Q11: LLM follow-up questions (needs ASI1_API_KEY). 0 = off, rules replies only.
LLM_FOLLOWUP=1

# TrueForge: no secrets here. Model keys go in the TrueForge UI (Settings → Models), never in .env.
TRUEFORGE_BASE_URL=http://localhost:8790
TF_MODEL=asi1/asi-1
# Blank = agent/agent.json name (agent-doctor).
TF_AGENT_NAME=
SKILL_REPO_URL=https://github.com/luis07saso-dot/agent-doctor
# Only when the TrueForge server has OIDC login on. Local npx needs none.
TRUEFORGE_TOKEN=
# Override agent/agent.json skill_mode: inline | git. Blank = agent.json.
TF_SKILL_MODE=
# Private literals npm run scan / scrub must reject (comma list, e.g. a private host). Local only.
SCAN_DENY=
